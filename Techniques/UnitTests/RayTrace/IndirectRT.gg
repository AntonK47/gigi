{
    "$schema": "gigischema.json",
    "version": "1.02",
    "variables": [
        {
            "name": "InvViewProjMtx",
            "type": "Float4x4"
        },
        {
            "name": "CameraPos",
            "type": "Float3"
        },
        {
            "name": "IndirectRtRayGen_RayGen_GpuAddress",
            "type": "Uint_64"
        },
        {
            "name": "IndirectRtRayGen_Miss_GpuAddress",
            "type": "Uint_64",
            "dflt": "0"
        },
        {
            "name": "IndirectRtRayGen_HitGroup_GpuAddress",
            "type": "Uint_64",
            "dflt": "0"
        }
    ],
    "shaders": [
        {
            "name": "IndirectRT_Fill",
            "fileName": "IndirectRT_Fill.hlsl",
            "entryPoint": "IndirectRT_Fill",
            "resources": [
                {
                    "name": "IndirectRtData",
                    "access": "UAV",
                    "type": "Buffer",
                    "buffer": {
                        "type": "Uint",
                        "raw": true,
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "IndirectBuffer",
                    "access": "UAV",
                    "type": "Buffer",
                    "buffer": {
                        "type": "Uint",
                        "raw": true,
                        "PODAsStructuredBuffer": false
                    }
                },
                {
                    "name": "IndirectCount",
                    "access": "UAV",
                    "type": "Buffer",
                    "buffer": {
                        "type": "Uint",
                        "raw": true,
                        "PODAsStructuredBuffer": false
                    }
                }
            ]
        },
        {
            "name": "IndirectRtRayGen",
            "fileName": "IndirectRt.hlsl",
            "type": "RTRayGen",
            "entryPoint": "IndirectRtRayGen",
            "resources": [
                {
                    "name": "Scene",
                    "access": "RTScene"
                },
                {
                    "name": "SceneVertexBuffer",
                    "access": "SRV",
                    "type": "Buffer",
                    "buffer": {
                        "typeStruct": {
                            "name": "Vertex"
                        }
                    }
                },
                {
                    "name": "Output",
                    "access": "UAV",
                    "type": "Texture",
                    "texture": {
                        "globallyCoherent": true
                    }
                },
                {
                    "name": "IndirectRtData",
                    "access": "SRV",
                    "type": "Buffer",
                    "buffer": {
                        "type": "Uint",
                        "raw": true,
                        "PODAsStructuredBuffer": false
                    }
                }
            ]
        },
        {
            "name": "IndirectRtMiss",
            "fileName": "IndirectRt.hlsl",
            "type": "RTMiss",
            "entryPoint": "IndirectRtMiss",
            "copyFile": false
        },
        {
            "name": "IndirectRtCloasestHit",
            "fileName": "IndirectRt.hlsl",
            "type": "RTClosestHit",
            "entryPoint": "IndirectRtCloasestHit",
            "copyFile": false
        },
        {
            "name": "IndirectRtAnyHit",
            "fileName": "IndirectRt.hlsl",
            "type": "RTAnyHit",
            "entryPoint": "IndirectRtAnyHit",
            "copyFile": false
        }
    ],
